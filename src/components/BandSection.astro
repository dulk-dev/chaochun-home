---
interface Props {
  id: string;
  title: string;
  num: string;
  lead: string;
}

const { id, title, num, lead } = Astro.props;
const headingId = `${id}-title`;
---

<section class="band" id={id} aria-labelledby={headingId}>
  <div class="band-head">
    <h2 id={headingId}>{title}</h2>
    <span class="num" aria-hidden="true">{num}</span>
  </div>
  <p class="lead">{lead}</p>
  <div class="cards">
    <slot />
  </div>
</section>
