---
import Arrow from "./Arrow.astro";

interface Props {
  href: string;
  kicker: string;
  title: string;
  description: string;
  cta: string;
  cover: string;
  badge?: string;
}

const { href, kicker, title, description, cta, cover, badge } = Astro.props;
---

<a class="card" href={href} target="_blank" rel="noopener noreferrer">
  <div class="cover">
    <img src={cover} alt="" width="1152" height="864" />
  </div>
  <div class="card-body">
    <span class="kicker">{kicker}</span>
    <h3>
      {badge && <img class="badge" src={badge} alt="" width="22" height="22" />}
      {title}
    </h3>
    <p>{description}</p>
    <span class="go">
      {cta}
      <Arrow />
      <span class="sr-only">（新页面打开）</span>
    </span>
  </div>
</a>
